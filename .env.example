# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会被提交）

# ===== 表达层大模型（澄清润色 / 知识问答 / 闲聊 / 话术生成）=====
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 路由层（TurnPlanner）：vLLM --enable-lora 部署的微调 Qwen3-1.7B =====
# LLM_ROUTER_MODEL 填 vLLM --lora-modules 的别名；
# 地址为 AutoDL 公网 HTTPS 端口映射，实例重启会变，需同步更新；
# 回滚到 teacher 大模型：把下面三行改成与 LLM_MODEL/BASE_URL/API_KEY 同值即可
LLM_ROUTER_MODEL=turnplanner
LLM_ROUTER_BASE_URL=https://<实例映射域名>.seetacloud.com:8443/v1
LLM_ROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 中台电商业务 API =====
COMMERCE_API_BASE_URL=http://<中台服务地址>:18081

# ===== 对话历史 / LangGraph checkpointer 数据库（MySQL）=====
DATABASE_URL=mysql+aiomysql://<user>:<password>@<host>:3306/customer_service?charset=utf8mb4

# ===== 服务监听 =====
APP_HOST=0.0.0.0
APP_PORT=18082

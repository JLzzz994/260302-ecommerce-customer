# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会被提交）

# ===== 表达层大模型（澄清 / 知识问答 / 闲聊 / 话术生成）=====
LLM_MODEL=<generation-model>
LLM_BASE_URL=<openai-compatible-base-url>
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 路由层：LoRA-SFT TurnPlanner，通过 vLLM OpenAI 兼容接口部署 =====
LLM_ROUTER_MODEL=turnplanner
LLM_ROUTER_BASE_URL=http://<turnplanner-vllm-host>:8000/v1
LLM_ROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 旺店通业务中台 API =====
COMMERCE_API_BASE_URL=http://<commerce-api-host>:18081

# ===== LangGraph Checkpoint：PostgreSQL =====
# 仅保存 GraphState、interrupt 恢复点等 LangGraph 运行状态，不承载订单/商品主数据。
CHECKPOINT_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/customer_service_checkpoint

# ===== 服务监听 =====
APP_HOST=0.0.0.0
APP_PORT=18082
